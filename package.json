{
  "name": "gauntlet",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Multi-agent code quality harness powered by Claude Code",
  "type": "module",
  "scripts": {
    "design": "tsx src/index.ts design",
    "build": "tsx src/index.ts build",
    "review": "tsx src/index.ts review",
    "security": "tsx src/index.ts security",
    "bugfinder": "tsx src/index.ts bugfinder",
    "status": "tsx src/index.ts status",
    "install-browsers": "npx playwright install --with-deps chromium firefox webkit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "lint:definitions": "tsx src/definitions.ts",
    "smoke": "bash scripts/cli-smoke.sh",
    "check": "npm run typecheck && npm run lint:definitions && npm test && npm run smoke"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
